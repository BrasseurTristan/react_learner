{
  "name": "react-learner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Apprends React + TypeScript en défendant ta base : un tower defense piloté par ton propre code.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "balance": "BALANCE=1 vitest run --reporter=dot"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "animejs": "^4.5.0",
    "marked": "^18.1.3",
    "monaco-editor": "^0.52.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sucrase": "^3.35.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^31.0.0",
    "typescript": "~5.9",
